{
    "name": "STM32F4 Demo",
    "api": {
        "client_interface_config": {
            "host": "0.0.0.0",
            "port": 8765
        }
    },
    "device": {
        "response_timeout": 1.0,
        "link_type": "serial",
        "link_config": {
            "portname": "/dev/ttyACM0",
            "baudrate": 1000000,
            "stopbits": 1,
            "databits": 8,
            "parity": "none"        
        }
    }
}